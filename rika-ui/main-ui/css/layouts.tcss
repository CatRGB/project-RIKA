Screen {
    background: #252a2c;
}

/* Titel oben */
#main_title {
    height: 3;
    margin: 1 2;
    border: solid white;
    content-align: center middle;
}

/* Gesamter Hauptbereich */
#main_content {
    height: 1fr;
    margin: 0 2 1 2;
}

/* Allgemeines Box-Design */
.box {
    border: solid white;
    background: #4b4d49;
    padding: 1;
}

/* Überschriften innerhalb der Boxen */
.box_title {
    height: 2;
    text-style: bold;
}

/* Gesamte linke Spalte */
#left_column {
    width: 30%;
    height: 100%;
    margin-right: 1;
}

/* Chat-Container links oben */
#chat_sidebar {
    width: 100%;
    height: 2fr;
    margin-bottom: 1;
}

/* Buttons in der Chat-Liste */
#chat_sidebar Button {
    width: 100%;
    margin-bottom: 1;
}

/* Konsolen-Container links unten */
#console_box {
    width: 100%;
    height: 1fr;
}

/* Eigentliche Konsolenausgabe */
#console_output {
    width: 100%;
    height: 1fr;
    background: #171a1b;
    border: solid gray;
    padding: 0 1;
}

/* Rechter Chatbereich */
#chat_area {
    width: 70%;
    height: 100%;
}

/* Chatverlauf */
#chat_history {
    height: 1fr;
    padding: 1;
}

/* Eingabebereich unten */
#input_row {
    width: 100%;
    height: 3;
}

/* Texteingabe */
#message_input {
    width: 1fr;
}

/* Senden-Button */
#send_button {
    width: 12;
    margin-left: 1;
}

/* Shortcut-Leiste ganz unten */
.bottom_bar {
    width: 100%;
    height: 1;
    content-align: center middle;
    color: white;
}